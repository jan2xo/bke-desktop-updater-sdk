<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>BKE.Desktop.UpdaterClient</PackageId>
    <Version>0.1.0</Version>
    <Authors>BKE</Authors>
    <Description>Foundation for future BKE updater request and status transport.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/jan2xo/bke-desktop-updater-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/package/</PackageOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="LICENSE" />
  </ItemGroup>
</Project>
